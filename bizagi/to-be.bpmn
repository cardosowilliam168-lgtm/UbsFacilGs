<?xml version="1.0" encoding="UTF-8"?>
<definitions id="defs_tobe" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://ubsfacil.example/bpmn">
<collaboration id="col_tobe"><participant id="par_tobe" name="UBS — Agendamento de consulta" processRef="proc_tobe"/></collaboration>
<process id="proc_tobe" name="TO-BE — Agendamento de consulta com o UBS Fácil (situação futura)" isExecutable="false">
<laneSet id="ls_tobe">
<lane id="lane_tobe_0" name="Cidadão"><flowNodeRef>s1</flowNodeRef><flowNodeRef>b1</flowNodeRef><flowNodeRef>b3</flowNodeRef><flowNodeRef>e1</flowNodeRef><flowNodeRef>b5b</flowNodeRef><flowNodeRef>g2</flowNodeRef><flowNodeRef>b6</flowNodeRef></lane>
<lane id="lane_tobe_1" name="Sistema UBS Fácil"><flowNodeRef>b2</flowNodeRef><flowNodeRef>g1</flowNodeRef><flowNodeRef>b4</flowNodeRef><flowNodeRef>b5</flowNodeRef><flowNodeRef>b7</flowNodeRef><flowNodeRef>e2</flowNodeRef><flowNodeRef>b8</flowNodeRef></lane>
<lane id="lane_tobe_2" name="Recepção da UBS"><flowNodeRef>b9</flowNodeRef></lane>
<lane id="lane_tobe_3" name="Equipe de Saúde"><flowNodeRef>b10</flowNodeRef><flowNodeRef>e3</flowNodeRef></lane>
</laneSet>
<startEvent id="s1" name="Precisa de consulta"><outgoing>f0</outgoing></startEvent>
<userTask id="b1" name="Acessar o app e escolher UBS, atendimento e horário"><incoming>f0</incoming><outgoing>f1</outgoing></userTask>
<serviceTask id="b2" name="Consultar disponibilidade em tempo real"><incoming>f1</incoming><outgoing>f2</outgoing></serviceTask>
<exclusiveGateway id="g1" name="Há vaga?"><incoming>f2</incoming><outgoing>f3</outgoing><outgoing>f5</outgoing></exclusiveGateway>
<userTask id="b3" name="Entrar na lista de espera ou escolher outro horário"><incoming>f3</incoming><outgoing>f4</outgoing></userTask>
<endEvent id="e1" name="Aguardando vaga"><incoming>f4</incoming></endEvent>
<serviceTask id="b4" name="Confirmar agendamento e gerar comprovante com QR Code"><incoming>f5</incoming><outgoing>f6</outgoing><dataOutputAssociation id="doa_b4"><targetRef>d1_ref</targetRef></dataOutputAssociation></serviceTask>
<serviceTask id="b5" name="Enviar lembrete 24 h antes"><incoming>f6</incoming><outgoing>f7</outgoing></serviceTask>
<userTask id="b5b" name="Responder ao lembrete"><incoming>f7</incoming><outgoing>f8</outgoing></userTask>
<exclusiveGateway id="g2" name="Confirma presença?"><incoming>f8</incoming><outgoing>f9</outgoing><outgoing>f10</outgoing></exclusiveGateway>
<userTask id="b6" name="Fazer check-in no dia (QR Code)"><incoming>f9</incoming><outgoing>f12</outgoing></userTask>
<serviceTask id="b7" name="Liberar a vaga e acionar a lista de espera"><incoming>f10</incoming><outgoing>f11</outgoing></serviceTask>
<endEvent id="e2" name="Vaga reaproveitada"><incoming>f11</incoming></endEvent>
<serviceTask id="b8" name="Atualizar fila virtual e avisar a chamada"><incoming>f12</incoming><outgoing>f13</outgoing></serviceTask>
<userTask id="b9" name="Acompanhar o painel e encaminhar o paciente"><incoming>f13</incoming><outgoing>f14</outgoing></userTask>
<userTask id="b10" name="Realizar o atendimento"><incoming>f14</incoming><outgoing>f15</outgoing></userTask>
<endEvent id="e3" name="Consulta realizada"><incoming>f15</incoming></endEvent>
