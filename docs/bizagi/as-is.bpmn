<?xml version="1.0" encoding="UTF-8"?>
<definitions id="defs_asis" xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://ubsfacil.example/bpmn">
<collaboration id="col_asis"><participant id="par_asis" name="UBS — Agendamento de consulta" processRef="proc_asis"/></collaboration>
<process id="proc_asis" name="AS-IS — Agendamento de consulta na UBS (situação atual, sem a solução)" isExecutable="false">
<laneSet id="ls_asis">
<lane id="lane_asis_0" name="Cidadão"><flowNodeRef>s1</flowNodeRef><flowNodeRef>a1</flowNodeRef><flowNodeRef>a3</flowNodeRef><flowNodeRef>e1</flowNodeRef><flowNodeRef>a5</flowNodeRef><flowNodeRef>g2</flowNodeRef><flowNodeRef>e2</flowNodeRef></lane>
<lane id="lane_asis_1" name="Recepção da UBS"><flowNodeRef>a2</flowNodeRef><flowNodeRef>g1</flowNodeRef><flowNodeRef>a4</flowNodeRef></lane>
<lane id="lane_asis_2" name="Equipe de Saúde"><flowNodeRef>a6</flowNodeRef><flowNodeRef>e3</flowNodeRef></lane>
</laneSet>
<startEvent id="s1" name="Precisa de consulta"><outgoing>f0</outgoing></startEvent>
<userTask id="a1" name="Ir à UBS de madrugada e entrar na fila"><incoming>f0</incoming><outgoing>f1</outgoing></userTask>
<userTask id="a2" name="Atender no balcão e consultar as vagas do dia"><incoming>f1</incoming><outgoing>f2</outgoing></userTask>
<exclusiveGateway id="g1" name="Há vaga?"><incoming>f2</incoming><outgoing>f3</outgoing><outgoing>f5</outgoing></exclusiveGateway>
<userTask id="a3" name="Voltar para casa sem consulta"><incoming>f3</incoming><outgoing>f4</outgoing></userTask>
<endEvent id="e1" name="Sem atendimento"><incoming>f4</incoming></endEvent>
<userTask id="a4" name="Registrar o agendamento na ficha de papel"><incoming>f5</incoming><outgoing>f6</outgoing><dataOutputAssociation id="doa_a4"><targetRef>d1_ref</targetRef></dataOutputAssociation></userTask>
<userTask id="a5" name="Aguardar a data agendada (sem lembrete)"><incoming>f6</incoming><outgoing>f7</outgoing></userTask>
<exclusiveGateway id="g2" name="Compareceu?"><incoming>f7</incoming><outgoing>f8</outgoing><outgoing>f9</outgoing></exclusiveGateway>
<endEvent id="e2" name="Falta registrada (vaga ociosa)"><incoming>f8</incoming></endEvent>
<userTask id="a6" name="Realizar o atendimento"><incoming>f9</incoming><outgoing>f10</outgoing></userTask>
<endEvent id="e3" name="Consulta realizada"><incoming>f10</incoming></endEvent>
<sequenceFlow id="f0" sourceRef="s1" targetRef="a1"/>
<sequenceFlow id="f1" sourceRef="a1" targetRef="a2"/>
<sequenceFlow id="f2" sourceRef="a2" targetRef="g1"/>
<sequenceFlow id="f3" sourceRef="g1" targetRef="a3" name="Não"/>
<sequenceFlow id="f4" sourceRef="a3" targetRef="e1"/>
<sequenceFlow id="f5" sourceRef="g1" targetRef="a4" name="Sim"/>
<sequenceFlow id="f6" sourceRef="a4" targetRef="a5"/>
<sequenceFlow id="f7" sourceRef="a5" targetRef="g2"/>
<sequenceFlow id="f8" sourceRef="g2" targetRef="e2" name="Não"/>
<sequenceFlow id="f9" sourceRef="g2" targetRef="a6" name="Sim"/>
<sequenceFlow id="f10" sourceRef="a6" targetRef="e3"/>
<dataObject id="d1" name="Ficha de agendamento (papel)"/>
<dataObjectReference id="d1_ref" name="Ficha de agendamento (papel)" dataObjectRef="d1"/>
</process>
